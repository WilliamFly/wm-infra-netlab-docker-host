#!/bin/bash
# Managed by Ansible (docker-host role) — do not edit by hand.
# Restricts Docker-published container ports to their configured source.
# ufw cannot see this traffic (Docker forwards it via its own DOCKER-USER
# chain, ahead of ufw), so this is enforced independently, at boot,
# instead of relying on iptables-persistent (which conflicts with ufw).
set -e
iptables -F DOCKER-USER

# Always allow established/related traffic first. A reply packet (e.g. a
# container's SYN-ACK) shows up here with the container's raw bridge IP
# as its source — un-DNAT happens later, in POSTROUTING — so a per-port
# source match alone would incorrectly drop legitimate replies. This
# rule must come before the per-port rules below.
iptables -A DOCKER-USER -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT

{% for item in docker_published_ports %}
iptables -A DOCKER-USER -p {{ item.proto }} -m conntrack --ctorigdstport {{ item.port }} -s {{ item.from }} -j ACCEPT
iptables -A DOCKER-USER -p {{ item.proto }} -m conntrack --ctorigdstport {{ item.port }} -j DROP
{% endfor %}
